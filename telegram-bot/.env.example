BOT_TOKEN=
ADMIN_ID=

# Текстовые модели через OpenAI SDK. BASE_URL пустой — официальный API.
# Для совместимого провайдера укажите свой URL, например https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=
BASIC_TEXT_MODEL=gpt-4o-mini
TOP_TEXT_MODEL=gpt-4o

# Необязательно. Если ключа нет, модель Claude скрыта и бот всё равно стартует.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Картинки: OpenAI Images API или совместимый base URL.
# Если ключа нет, генерация картинок скрыта.
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=dall-e-3

PRO_PRICE_STARS=500
UNLIMITED_PRICE_STARS=1500

# Файл SQLite рядом с ботом. В git не попадает.
DB_PATH=bot.db
